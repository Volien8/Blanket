  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 1,
      "text": "\u041e\u0414\u0415\u042f\u041b\u041e",
      "style": "Title"
    },
    {
      "para_index": 2,
      "text": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0432\u0435\u0441\u0442\u0430",
      "style": "Subtitle"
    },
    {
      "para_index": 1061,
      "text": "\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0448\u0438\u0431\u043e\u043a \u0438 \u0441\u043c\u0435\u0448\u043d\u043e\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0434\u043b\u044f \u00ab\u041e\u0414\u0415\u042f\u041b\u041e\u00bb",
      "style": "Normal"
    },
    {
      "para_index": 1062,
      "text": "\u0427\u0430\u0441\u0442\u044c 1. \u0427\u0442\u043e \u0441\u043b\u043e\u043c\u0430\u043d\u043e \u0438 \u043a\u0430\u043a \u0447\u0438\u043d\u0438\u0442\u044c (\u043f\u043e \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0430\u043c)",
      "style": "Normal"
    },
    {
      "para_index": 1063,
      "text": "1.1. \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0438\u0441\u0445\u043e\u0434\u043e\u0432 (\u0434\u043e\u043b\u0433, \u043a\u043e\u0441\u0442\u044b\u043b\u044c\u043d\u044b\u0439 \u0434\u043e\u043b\u0433, \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044f, \u0431\u0430\u0433\u0438, \u0438\u0441\u043a, \u0441\u0435\u0440\u044b\u0439 \u0438\u0441\u0445\u043e\u0434)",
      "style": "Normal"
    },
    {
      "para_index": 1207,
      "text": "1.3. \u0417\u043e\u043d\u044b \u043e\u0444\u0438\u0441\u0430 \u00ab\u0421\u0442\u043e\u043b \u0420\u041f\u00bb, \u00ab\u0421\u043e\u0441\u0435\u0434\u043d\u0438\u0439\u00bb, \u00ab\u0417\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0438\u00bb \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0445\u043e\u0432\u0435\u0440",
      "style": "Normal"
    },
    {
      "para_index": 1354,
      "text": "\u0427\u0430\u0441\u0442\u044c 2. \u0421\u043c\u0435\u0448\u043d\u044b\u0435 \u0434\u0438\u0430\u043b\u043e\u0433\u0438 (\u0440\u0430\u0437\u0434\u0435\u043b\u044b 1\u20138 + \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0431\u0435\u0437 \u043c\u0435\u0445\u0430\u043d\u0438\u043a)",
      "style": "Normal"
    },
    {
      "para_index": 1355,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 1. \u0422\u0438\u043c\u043b\u0438\u0434 BE \u043f\u0440\u043e\u0441\u0438\u0442 \u0440\u0435\u0441\u0443\u0440\u0441 (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0440\u0435\u0441\u0443\u0440\u0441 \u043e\u0434\u0438\u043d\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1381,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 2. QA \u043f\u0440\u043e\u0441\u0438\u0442 \u0431\u0443\u043c\u0430\u0436\u043a\u0438 (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0431\u0443\u043c\u0430\u0436\u043a\u0438/\u0431\u0430\u0433\u0438\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1401,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 3. \u0411\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0438\u044f \u043d\u043e\u0447\u044c\u044e (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0434\u043e\u043b\u0433/\u0448\u0442\u0440\u0430\u0444\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1421,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 4. \u041f\u0440\u043e\u0434\u0430\u0436\u0438 \u043e\u0431\u0435\u0449\u0430\u044e\u0442 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0443 (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0441\u044e\u0440\u043f\u0440\u0438\u0437 \u043f\u0440\u043e\u0434\u0430\u0436\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1436,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 5. \u0417\u0430\u043a\u0430\u0437\u0447\u0438\u043a Legal (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u044e\u0440\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435/\u0438\u0441\u043a\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1462,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 6. \u00ab\u0421\u043e\u0441\u0435\u0434\u043d\u0438\u0439\u00bb (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432)",
      "style": "Normal"
    },
    {
      "para_index": 1482,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 7. \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u044f\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1497,
      "text": "\u0414\u0438\u0430\u043b\u043e\u0433 8. \u0424\u0438\u043d\u0430\u043b \u2014 \u0441\u0435\u0440\u044b\u0439 \u0438\u0441\u0445\u043e\u0434 (\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u00ab\u0441\u0435\u0440\u044b\u0439 \u0438\u0441\u0445\u043e\u0434\u00bb)",
      "style": "Normal"
    },
    {
      "para_index": 1508,
      "text": "\u0427\u0430\u0441\u0442\u044c 3. \u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0447\u0435\u043a-\u043b\u0438\u0441\u0442 \u043f\u0440\u0430\u0432\u043e\u043a \u0432 \u043a\u043e\u0434\u0435",
      "style": "Normal"
    },
    {
      "para_index": 1520,
      "text": "\u00ab\u041e\u0414\u0415\u042f\u041b\u041e\u00bb \u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 NET \u2014 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044f \u0438 \u043f\u0440\u0430\u0432\u043e\u043a",
      "style": "Normal"
    },
    {
      "para_index": 1521,
      "text": "\u0427\u0430\u0441\u0442\u044c 0. \u0427\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u0442 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430 \u0432 NET",
      "style": "Normal"
    },
    {
      "para_index": 1531,
      "text": "\u0427\u0430\u0441\u0442\u044c 1. \u041f\u0440\u0430\u0432\u043a\u0438 \u043a\u043e\u0434\u0430 \u0441 \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u043e\u0439 \u043a NET",
      "style": "Normal"
    },
